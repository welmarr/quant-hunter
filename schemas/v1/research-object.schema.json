{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/research-object.schema.json",
  "title": "Quant Hunter Research Family, Model, or Strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "object_type",
    "revision",
    "previous_revision_digest",
    "created_at",
    "status",
    "name",
    "hypothesis",
    "rationale",
    "source_citations",
    "mathematical_definition",
    "inputs",
    "outputs",
    "horizon",
    "sampling_frequency",
    "universe",
    "assumptions",
    "search_space",
    "baseline_ids",
    "data_requirements",
    "owner",
    "academic_institutional_basis",
    "evidence_quality",
    "independent_replication_evidence",
    "fx_applicability",
    "known_failures_or_decay",
    "distinctiveness",
    "validation_plan",
    "transaction_cost_sensitivity",
    "capacity_sensitivity",
    "risk_sensitivity",
    "regime_sensitivity",
    "decision",
    "limitations",
    "failure_modes",
    "parameters",
    "research_family_id",
    "successor_ids",
    "experiment_ids",
    "parameter_search_accounting",
    "implementation",
    "reproduction_outcome",
    "parent_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "common.schema.json#/$defs/research_object_id"
    },
    "object_type": {
      "enum": [
        "RESEARCH_FAMILY",
        "MODEL",
        "STRATEGY"
      ]
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "previous_revision_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/digest"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "REPRODUCTION",
        "RESEARCH",
        "VALIDATED",
        "REJECTED",
        "RETIRED",
        "SUPERSEDED"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "source_citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "mathematical_definition": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "horizon": {
      "type": "string",
      "minLength": 1
    },
    "sampling_frequency": {
      "type": "string",
      "minLength": 1
    },
    "universe": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_space": {
      "type": "string",
      "minLength": 1
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/research_object_id"
      },
      "uniqueItems": true
    },
    "baseline_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/research_object_id"
      },
      "uniqueItems": true
    },
    "data_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "dataset_ids",
        "point_in_time_constraints",
        "availability",
        "licensing",
        "expected_cost"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source_id"
          },
          "uniqueItems": true
        },
        "dataset_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/dataset_id"
          },
          "uniqueItems": true
        },
        "point_in_time_constraints": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "$ref": "#/$defs/unavailable"
            }
          ]
        },
        "licensing": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "$ref": "#/$defs/unavailable"
            }
          ]
        },
        "expected_cost": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "$ref": "#/$defs/unavailable"
            }
          ]
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "academic_institutional_basis": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "evidence_quality": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "independent_replication_evidence": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "fx_applicability": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "known_failures_or_decay": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "distinctiveness": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "validation_plan": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "transaction_cost_sensitivity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "capacity_sensitivity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "risk_sensitivity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "regime_sensitivity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "limitations": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "failure_modes": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "parameters": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    },
    "research_family_id": {
      "$ref": "common.schema.json#/$defs/family_id"
    },
    "successor_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/research_object_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/experiment_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "parameter_search_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_search_space",
        "ai_generated_variants",
        "combination_count"
      ],
      "properties": {
        "complete_search_space": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ai_generated_variants": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "combination_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "implementation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exists",
            "location",
            "code_revision"
          ],
          "properties": {
            "exists": {
              "const": true
            },
            "location": {
              "type": "string",
              "format": "uri"
            },
            "code_revision": {
              "$ref": "common.schema.json#/$defs/git_revision"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exists",
            "reason"
          ],
          "properties": {
            "exists": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "reproduction_outcome": {
      "oneOf": [
        {
          "enum": [
            "REPRODUCED",
            "PARTIALLY REPRODUCED",
            "NOT REPRODUCIBLE WITH AVAILABLE DATA"
          ]
        },
        {
          "$ref": "#/$defs/unavailable"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "previous_revision_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_revision_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object_type": {
            "const": "RESEARCH_FAMILY"
          }
        }
      },
      "then": {
        "properties": {
          "object_id": {
            "$ref": "common.schema.json#/$defs/family_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object_type": {
            "const": "MODEL"
          }
        }
      },
      "then": {
        "properties": {
          "object_id": {
            "$ref": "common.schema.json#/$defs/model_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object_type": {
            "const": "STRATEGY"
          }
        }
      },
      "then": {
        "properties": {
          "object_id": {
            "$ref": "common.schema.json#/$defs/strategy_id"
          }
        }
      }
    }
  ],
  "$defs": {
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "NOT_APPLICABLE",
            "PENDING"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
