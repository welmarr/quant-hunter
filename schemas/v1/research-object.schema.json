{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/research-object.schema.json",
  "title": "Quant Hunter Research Family, Model, or Strategy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "object_type",
    "revision",
    "previous_revision_digest",
    "created_at",
    "status",
    "name",
    "hypothesis",
    "rationale",
    "source_citations",
    "mathematical_definition",
    "inputs",
    "outputs",
    "horizon",
    "sampling_frequency",
    "universe",
    "assumptions",
    "search_space",
    "baseline_ids",
    "data_requirements",
    "owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_id": {"$ref": "common.schema.json#/$defs/research_object_id"},
    "object_type": {"enum": ["RESEARCH_FAMILY", "MODEL", "STRATEGY"]},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "previous_revision_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/digest"}
      ]
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {
      "enum": [
        "PROPOSED",
        "REPRODUCTION",
        "RESEARCH",
        "VALIDATED",
        "REJECTED",
        "RETIRED",
        "SUPERSEDED"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "source_citations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "mathematical_definition": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "horizon": {"type": "string", "minLength": 1},
    "sampling_frequency": {"type": "string", "minLength": 1},
    "universe": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "search_space": {"type": "string", "minLength": 1},
    "parent_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/research_object_id"},
      "uniqueItems": true
    },
    "baseline_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/research_object_id"},
      "uniqueItems": true
    },
    "data_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "dataset_ids", "point_in_time_constraints"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/source_id"},
          "uniqueItems": true
        },
        "dataset_ids": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/dataset_id"},
          "uniqueItems": true
        },
        "point_in_time_constraints": {"type": "string", "minLength": 1}
      }
    },
    "owner": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"revision": {"const": 1}}},
      "then": {"properties": {"previous_revision_digest": {"type": "null"}}},
      "else": {
        "properties": {
          "previous_revision_digest": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    },
    {
      "if": {"properties": {"object_type": {"const": "RESEARCH_FAMILY"}}},
      "then": {"properties": {"object_id": {"$ref": "common.schema.json#/$defs/family_id"}}}
    },
    {
      "if": {"properties": {"object_type": {"const": "MODEL"}}},
      "then": {"properties": {"object_id": {"$ref": "common.schema.json#/$defs/model_id"}}}
    },
    {
      "if": {"properties": {"object_type": {"const": "STRATEGY"}}},
      "then": {"properties": {"object_id": {"$ref": "common.schema.json#/$defs/strategy_id"}}}
    }
  ]
}
