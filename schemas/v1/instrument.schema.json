{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/instrument.schema.json",
  "title": "Quant Hunter Instrument Metadata Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instrument_id", "revision", "previous_revision_digest", "instrument", "recorded_at", "reason", "evidence_mode", "source_reference"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "instrument_id": {"$ref": "common.schema.json#/$defs/instrument_id"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "previous_revision_digest": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/digest"}]},
    "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_mode": {"enum": ["SYNTHETIC", "HISTORICAL_DECLARED"]},
    "source_reference": {"type": "string", "minLength": 1, "maxLength": 1000},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "asset_class", "venue", "base_currency", "quote_currency", "price_precision", "quantity_precision", "lot_size", "tick_size", "multiplier", "timezone", "calendar_id", "activity", "symbols", "status"],
      "properties": {
        "instrument_id": {"$ref": "common.schema.json#/$defs/instrument_id"},
        "asset_class": {"enum": ["EQUITY", "ETF", "FX_SPOT"]},
        "venue": {"enum": ["XNYS", "OTC_NY_17_CONVENTION"]},
        "base_currency": {"$ref": "common.schema.json#/$defs/currency"},
        "quote_currency": {"$ref": "common.schema.json#/$defs/currency"},
        "price_precision": {"type": "integer", "minimum": 0, "maximum": 12},
        "quantity_precision": {"type": "integer", "minimum": 0, "maximum": 12},
        "lot_size": {"type": "string", "maxLength": 40, "pattern": "^(?:0|[1-9][0-9]*)(?:[.][0-9]+)?$"},
        "tick_size": {"type": "string", "maxLength": 40, "pattern": "^(?:0|[1-9][0-9]*)(?:[.][0-9]+)?$"},
        "multiplier": {"const": "1"},
        "timezone": {"const": "America/New_York"},
        "calendar_id": {"enum": ["XNYS", "FX_NY_17"]},
        "activity": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/interval"}},
        "symbols": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["symbol", "start", "end"],
            "properties": {
              "symbol": {"type": "string", "pattern": "^[A-Z0-9._/-]{1,32}$"},
              "start": {"$ref": "common.schema.json#/$defs/timestamp"},
              "end": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]}
            }
          }
        },
        "status": {"enum": ["ACTIVE", "INACTIVE", "DELISTED"]}
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "common.schema.json#/$defs/timestamp"},
        "end": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]}
      }
    }
  }
}
