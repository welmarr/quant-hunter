{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/artifact-manifest.schema.json",
  "title": "Quant Hunter Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_digest",
    "artifact_type",
    "media_type",
    "byte_size",
    "created_at",
    "producer"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "artifact_type": {
      "enum": ["configuration", "environment", "dataset", "model", "report", "other"]
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "byte_size": {"type": "integer", "minimum": 0},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_revision", "command", "environment_digest"],
      "properties": {
        "code_revision": {"$ref": "common.schema.json#/$defs/git_revision"},
        "command": {"type": "string", "minLength": 1},
        "environment_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "parent_digests": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/digest"},
      "uniqueItems": true
    }
  }
}
