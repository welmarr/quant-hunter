{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/dataset.schema.json",
  "title": "Quant Hunter Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "revision",
    "previous_revision_digest",
    "created_at",
    "layer",
    "source_ids",
    "coverage",
    "time_fields",
    "schema_digest",
    "physical_object_digest",
    "provenance_lineage_digest",
    "provenance",
    "quality_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"$ref": "common.schema.json#/$defs/dataset_id"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "previous_revision_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/digest"}
      ]
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "layer": {
      "enum": [
        "raw_landing",
        "normalized",
        "curated",
        "features",
        "experiment_snapshot",
        "sealed_holdout"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/source_id"},
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "common.schema.json#/$defs/timestamp"},
        "end": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "time_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_time", "publication_time", "ingestion_time", "revision_time"],
      "properties": {
        "event_time": {"$ref": "#/$defs/field_or_not_applicable"},
        "publication_time": {"$ref": "#/$defs/field_or_not_applicable"},
        "ingestion_time": {"$ref": "#/$defs/field_or_not_applicable"},
        "revision_time": {"$ref": "#/$defs/field_or_not_applicable"}
      }
    },
    "schema_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "physical_object_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "provenance_lineage_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "logical_content_fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_dataset_ids",
        "transformation",
        "code_revision",
        "environment_digest"
      ],
      "properties": {
        "parent_dataset_ids": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/dataset_id"},
          "uniqueItems": true
        },
        "transformation": {"type": "string", "minLength": 1},
        "code_revision": {"$ref": "common.schema.json#/$defs/git_revision"},
        "environment_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "quality_status": {"enum": ["PENDING", "APPROVED", "QUARANTINED", "REJECTED"]}
  },
  "$defs": {
    "field_or_not_applicable": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {"const": "NOT_APPLICABLE"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"revision": {"const": 1}}},
      "then": {"properties": {"previous_revision_digest": {"type": "null"}}},
      "else": {
        "properties": {
          "previous_revision_digest": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    },
    {
      "if": {
        "properties": {"layer": {"not": {"const": "raw_landing"}}}
      },
      "then": {"required": ["logical_content_fingerprint"]}
    }
  ]
}
