{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/common.schema.json",
  "title": "Quant Hunter Common Schema Definitions",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "normalized_decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:[.][0-9]+)?$"
    },
    "normalized_nonnegative_decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:[.][0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "family_id": {
      "type": "string",
      "pattern": "^FAM-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^MOD-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "research_object_id": {
      "oneOf": [
        {"$ref": "#/$defs/family_id"},
        {"$ref": "#/$defs/model_id"},
        {"$ref": "#/$defs/strategy_id"}
      ]
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^PATTERN-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SOURCE-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^DATASET-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "backlog_id": {
      "type": "string",
      "pattern": "^BACKLOG-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cost_id": {
      "type": "string",
      "pattern": "^COST-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "any_object_id": {
      "oneOf": [
        {"$ref": "#/$defs/research_object_id"},
        {"$ref": "#/$defs/pattern_id"},
        {"$ref": "#/$defs/experiment_id"},
        {"$ref": "#/$defs/source_id"},
        {"$ref": "#/$defs/dataset_id"},
        {"$ref": "#/$defs/backlog_id"},
        {"$ref": "#/$defs/cost_id"}
      ]
    }
  }
}
