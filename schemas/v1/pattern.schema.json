{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/welmarr/quant-hunter/schemas/v1/pattern.schema.json",
  "title": "Quant Hunter Pattern Research Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern_id",
    "revision",
    "previous_revision_digest",
    "created_at",
    "status",
    "name",
    "hypothesis",
    "algorithm_family",
    "definition",
    "features",
    "normalization_method",
    "similarity_metric",
    "horizons",
    "markets",
    "regimes",
    "discovery_dataset_id",
    "validation_dataset_id",
    "sealed_dataset_id",
    "candidate_count",
    "outcome_definition",
    "owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pattern_id": {"$ref": "common.schema.json#/$defs/pattern_id"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "previous_revision_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/digest"}
      ]
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {
      "enum": ["PROPOSED", "RESEARCH", "VALIDATED", "REJECTED", "RETIRED", "SUPERSEDED"]
    },
    "name": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "algorithm_family": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "normalization_method": {"type": "string", "minLength": 1},
    "similarity_metric": {"type": "string", "minLength": 1},
    "horizons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "regimes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "discovery_dataset_id": {"$ref": "common.schema.json#/$defs/dataset_id"},
    "validation_dataset_id": {"$ref": "common.schema.json#/$defs/dataset_id"},
    "sealed_dataset_id": {"$ref": "common.schema.json#/$defs/dataset_id"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "outcome_definition": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"revision": {"const": 1}}},
      "then": {"properties": {"previous_revision_digest": {"type": "null"}}},
      "else": {
        "properties": {
          "previous_revision_digest": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    }
  ]
}
